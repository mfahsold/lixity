<body id="top" tabindex="-1" class="site-page public-home">
<a class="skip-link" href="#content">$skip</a>
<header class="site-header"><div class="header-inner">
<a class="brand" href="$home_path" aria-current="page"><img src="assets/mark.svg" width="32" height="32" alt=""/><span class="brand-name">Lixity</span></a>
<nav aria-label="$product" class="home-nav"><a href="#features">$product</a><a href="#installation">$install</a><a href="#guides">$docs</a></nav>
<details class="language-picker"><summary>$language_name</summary><nav aria-label="$language">$language_links</nav></details>
<button class="ctl theme-btn" id="themeToggle" type="button" hidden>Theme</button>
</div></header>
<main id="content">
<aside id="language-suggestion" class="language-suggestion" aria-label="$language" hidden><p>$language_suggestion</p><a class="ctl primary" href="index.html"></a><button class="ctl" type="button">$language_stay</button></aside>
<section class="home-hero" aria-labelledby="intro-title">
<div class="home-intro"><p class="home-eyebrow">$eyebrow</p><h1 id="intro-title">$headline</h1><p class="home-lead">$intro</p>
<div class="hero-cta"><a class="ctl primary" href="#product-tour-preview" id="examples">$discover <span aria-hidden="true">↓</span></a> <a class="ctl" href="sandbox/index.html" id="sandbox-cta">$sandbox_cta <span aria-hidden="true">→</span></a></div><p class="home-note">$demo_note</p></div>
<figure id="product-tour-preview" tabindex="-1" class="product-preview product-tour" aria-label="$tour_title">
<div class="tour-screen">
<video id="product-tour" width="1440" height="900" poster="videos/product-tour.webp" preload="none" muted playsinline controls aria-label="$tour_title" aria-describedby="tour-note">
<source src="videos/product-tour.webm" type='video/webm; codecs="av01.0.08M.08"'/>
<source src="videos/product-tour.mp4" type="video/mp4"/>
<a href="demo/report.html">$demo</a>
</video>
<div class="tour-caption" aria-hidden="true" hidden><span>$tour_read</span></div>
</div>
<figcaption>
<div class="tour-actions"><button type="button" class="ctl tour-toggle" data-play="$tour_play" data-pause="$tour_pause" hidden>$tour_play</button><a class="ctl tour-explore" href="demo/report.html">$demo <span aria-hidden="true">→</span></a><p id="tour-note">$tour_note</p></div>
<p class="tour-error" role="status" hidden>$tour_error <a href="demo/report.html">$demo</a></p>
<details id="tour-transcript"><summary>$tour_transcript</summary><ol>
<li data-start="0">$tour_read</li><li data-start="8">$tour_passage</li><li data-start="16">$tour_compare</li><li data-start="24">$tour_research</li><li data-start="32">$tour_context</li><li data-start="40">$tour_return</li>
</ol></details>
</figcaption>
</figure>
</section>
<section class="home-section" id="features"><h2>$tasks_title</h2><p>$workflow</p><p class="section-note">$editor_status</p><div class="home-tasks">
<article id="writing"><h3>$read_title</h3><p>$read_text</p><a href="WORKSPACE.md#write-a-manuscript-unreleased" lang="en">$editor_link</a></article>
<article id="linguistic-analysis"><h3>$linguistics_title</h3><p>$linguistics_text</p><a href="USAGE.md#linguistic-text-analysis">$linguistics_link</a></article>
<article id="research-workspace"><h3>$research_title</h3><p>$research_text</p><a href="$tour_url">$tour</a></article>
<article id="reading-copies"><h3>$share_title</h3><p>$share_text</p><a href="demo/reader/index.html" lang="en">Reading copy (English)</a></article>
</div></section>
<section class="home-principle" id="measurement-context"><span class="principle-mark" aria-hidden="true">“</span><div><h2>$principle</h2><p>$principle_text</p></div></section>
<section class="home-section home-start" id="installation"><div><h2>$start_title</h2><p>$start_text</p><a class="ctl primary" href="guides/installation.html">$install_link</a></div><div class="install-command"><pre><code>uv tool install --python 3.12 --managed-python lixity</code></pre><p>$scope</p><a href="https://github.com/mfahsold/lixity/releases/latest" lang="en">Published releases</a> · <a href="releases/v$version.md" id="current-release" lang="en">v$version release notes</a></div></section>
<section class="home-section" id="languages"><h2>$languages_title</h2><p>$languages_text</p><nav class="language-list" aria-label="$language">$language_links</nav><p class="section-note">$limits</p></section>
<section class="home-section home-resources" id="guides"><div><h2>$docs</h2><p lang="en">Technical guides, methods and automation contracts are maintained in English.</p><nav class="resource-links" lang="en" aria-label="English documentation"><a href="guides/first-look.html">First session</a><a href="guides/first-look-de.html" lang="de" hreflang="de">Einstieg auf Deutsch</a><a href="guides/interpretation.html">Understand the measurements</a><a href="guides/research-pdf.html">Sources and reading copies</a><a href="AUDIO.md">Audio and teleprompter</a><a href="README.md">All documentation</a><a href="blog/index.html">Articles</a><a href="AGENTS.md" id="cli-api">CLI and API</a><a href="METHODS.md" id="methods">Methods and limits</a></nav></div><div id="feedback"><h2>$feedback_title</h2><p>$feedback_text</p><a href="mailto:mfahsold@googlemail.com?subject=Lixity%20feedback">$feedback_link</a></div></section>
</main>
