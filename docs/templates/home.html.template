<!DOCTYPE html>
<!-- Generated by scripts/build_public_site.py; edit docs/templates and docs/locales. -->
<html lang="$lang" data-theme="auto">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>$title</title>
<meta name="description" content="$description"/>
<meta name="robots" content="max-image-preview:large"/>
<meta name="google-site-verification" content="dyCGbdIP0jwCou0a4L_1epggZFVtHKkGE3qQyP9gip0"/>
<link rel="canonical" href="$canonical"/>
$alternates
<link rel="sitemap" type="application/xml" href="sitemap.xml"/>
<link rel="alternate" type="text/plain" href="llms.txt" title="Automation summary"/>
<link rel="icon" href="favicon.ico" sizes="any"/>
<link rel="icon" href="assets/brand/mark-adaptive.svg" type="image/svg+xml"/>
<link rel="apple-touch-icon" href="assets/brand/apple-touch-icon.png"/>
<link rel="manifest" href="manifest.webmanifest"/>
<meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)"/>
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/>
<meta name="fediverse:creator" content="@lixity@mastodon.social"/>
<link rel="preload" as="image" href="screenshots/dashboard-light.png" fetchpriority="high"/>
<link rel="stylesheet" href="assets/site.css"/>
<link rel="stylesheet" href="assets/home.css"/>
<script src="assets/site-language.js" defer></script>
<script src="assets/site.js" defer></script>
<script src="assets/product-tour.js" defer></script>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Lixity"/>
$og_locales
<meta property="og:title" content="$title"/>
<meta property="og:description" content="$description"/>
<meta property="og:url" content="$canonical"/>
<meta property="og:image" content="https://lixity.de/screenshots/dashboard-light.png"/>
<meta property="og:image:width" content="$image_width"/>
<meta property="og:image:height" content="$image_height"/>
<meta property="og:video" content="https://lixity.de/videos/product-tour.mp4"/>
<meta property="og:video:type" content="video/mp4"/>
<meta property="og:video:width" content="1440"/>
<meta property="og:video:height" content="900"/>
<meta property="og:image:alt" content="$preview"/>
<meta name="twitter:image:alt" content="$preview"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content="$title"/>
<meta name="twitter:description" content="$description"/>
<meta name="twitter:image" content="https://lixity.de/screenshots/dashboard-light.png"/>
<script type="application/ld+json">$structured</script>
</head>
<body id="top" tabindex="-1" class="site-page public-home">
<a class="skip-link" href="#content">$skip</a>
<header class="site-header"><div class="header-inner">
<a class="brand" href="$home_path" aria-current="page"><img src="assets/mark.svg" width="32" height="32" alt=""/><span class="brand-name">Lixity</span></a>
<div class="home-preferences">
<details class="language-picker"><summary>$language_name</summary><nav aria-label="$language">$language_links</nav></details>
<button class="ctl theme-btn" id="themeToggle" type="button" hidden>Theme</button>
</div>
<nav aria-label="$product" class="home-nav"><a href="#features">$product</a><a href="#installation">$install</a><a href="#guides">$nav_docs</a></nav>
</div></header>
<main id="content">
<aside id="language-suggestion" class="language-suggestion" aria-label="$language" hidden><p>$language_suggestion</p><a class="ctl primary" href="index.html"></a><button class="ctl" type="button">$language_stay</button></aside>
<section class="home-hero" aria-labelledby="intro-title">
<div class="home-intro">
<h1 id="intro-title">$headline</h1>
<div class="home-intro-copy"><p class="home-lead">$intro</p>
<div class="hero-cta"><a class="ctl primary" href="guides/installation.html" hreflang="en" id="download-cta">$install_link <span aria-hidden="true">→</span></a> <a class="ctl" href="#product-tour-preview" id="examples">$discover <span aria-hidden="true">↓</span></a></div></div>
<aside class="home-support" id="support" aria-labelledby="support-title">
<img src="assets/mark.svg" width="40" height="40" alt=""/>
<div class="support-copy"><h2 id="support-title">$funding_title</h2><p>$funding_summary</p></div>
<a class="ctl" id="support-cta" href="$funding_url" hreflang="en">$funding <span aria-hidden="true">→</span></a>
</aside></div>
<figure id="product-tour-preview" tabindex="-1" class="product-preview product-tour" aria-label="$tour_title">
<div class="tour-screen">
<video id="product-tour" width="1440" height="900" poster="screenshots/dashboard-light.png" preload="none" muted playsinline controls aria-label="$tour_title" aria-describedby="tour-note">
<source src="videos/product-tour.webm" type='video/webm; codecs="av01.0.08M.08"'/>
<source src="videos/product-tour.mp4" type="video/mp4"/>
<a href="demo/report.html" hreflang="en">$demo</a>
</video>
<div class="tour-caption" aria-hidden="true" hidden><span>$tour_read</span></div>
</div>
<figcaption>
<div class="tour-actions"><button type="button" class="ctl tour-toggle" data-play="$tour_play" data-pause="$tour_pause" hidden>$tour_play</button><a class="ctl tour-explore" href="demo/report.html" hreflang="en">$demo <span aria-hidden="true">→</span></a><p id="tour-note">$tour_note</p></div>
<p class="tour-error" role="status" hidden>$tour_error <a href="demo/report.html" hreflang="en">$demo</a></p>
<details id="tour-transcript"><summary>$tour_transcript</summary><ol>
$tour_cues
</ol></details>
<details id="tour-share"><summary>$tour_share</summary><div class="home-task-links">
<a href="videos/social-hook-9x16.mp4" hreflang="en" download>$tour_share_vertical</a>
<a href="videos/social-hook-16x9.mp4" hreflang="en" download>$tour_share_horizontal</a>
<a href="screenshots/dashboard-measurement-focus.png" hreflang="en" download>$tour_share_image</a>
</div></details>
</figcaption>
</figure>
</section>
<section class="home-section" id="features" aria-labelledby="features-title"><h2 id="features-title">$tasks_title</h2><div class="home-tasks">
<article id="writing" class="home-feature"><h3>$read_title</h3><p>$read_text</p><div class="home-task-links"><a href="https://github.com/mfahsold/lixity/blob/main/docs/WORKSPACE.md#write-a-manuscript" hreflang="en">$editor_link</a></div></article>
<article id="linguistic-analysis" class="home-feature"><h3>$linguistics_title</h3><p>$linguistics_text</p><div class="home-task-links"><a href="$rhythm_guide_path" hreflang="$passage_guide_language">$rhythm_guide_link</a><a href="guides/metrics/${lang}.html" hreflang="$lang">$linguistics_link</a></div></article>
<article id="research-workspace" class="home-feature"><h3>$research_title</h3><p>$research_text</p><div class="home-task-links"><a href="guides/research-pdf.html" hreflang="en">$research_guide_link</a></div></article>
<article id="reading-copies" class="home-feature"><h3>$share_title</h3><p>$share_text</p><div class="home-task-links"><a href="demo/warehouse-4-dossier.pdf" hreflang="en">$dossier_example</a><a href="demo/reader/index.html" hreflang="en">$reading_copy</a></div></article>
</div></section>
<section class="home-section home-principle" aria-labelledby="principle-title"><div><h2 id="principle-title">$principle</h2><p>$principle_text</p></div></section>
<section class="home-section" id="compare" aria-labelledby="product-questions-title">
<h2 id="product-questions-title">$questions_title</h2><div class="home-tasks home-answers">
<article><h3>$question_marks</h3><p>$answer_marks</p></article>
<article><h3>$question_local</h3><p>$answer_local</p></article>
<article><h3>$question_demo</h3><p>$answer_demo</p></article>
</div></section>
<section class="home-section" id="measurement-context" aria-labelledby="example-title">
<div class="home-editorial">
<div><h2 id="example-title">$example_title</h2><p class="home-example-finding">$example_finding</p><p id="sandbox-note">$demo_note</p></div>
<div class="home-editorial-links"><a class="ctl" href="sandbox/index.html?lang=$sandbox_language" hreflang="$sandbox_language" id="sandbox-cta" aria-describedby="sandbox-note">$sandbox_cta <span aria-hidden="true">→</span></a><a href="$passage_guide_path" hreflang="$passage_guide_language">$passage_guide_link</a><a href="$research_guide_path" hreflang="$passage_guide_language">$research_case_link</a><a href="guides/manuscript-analysis-tools.html" hreflang="en">$compare_tools_link</a></div>
</div></section>
<section class="home-section home-start" id="installation"><div><h2>$start_title</h2><p>$start_text</p><a class="ctl primary" href="guides/installation.html" hreflang="en">$install_link</a></div><div class="install-release"><p>$scope</p><a href="https://github.com/mfahsold/lixity/releases/latest" lang="en">Latest published release</a> · <a href="https://github.com/mfahsold/lixity/blob/main/docs/releases/v$version.md" id="current-release" lang="en">v$version release notes</a></div></section>
<section class="home-section" id="languages"><h2>$languages_title</h2><p>$languages_text</p><nav class="language-list" aria-label="$language">$language_links</nav><p class="section-note">$limits</p></section>
<section class="home-section home-resources" id="guides"><div><h2>$docs</h2><p lang="en">Technical guides, methods and automation contracts are maintained in English.</p><nav class="resource-links" lang="en" aria-label="English documentation"><a href="guides/first-look.html">First session</a><a href="guides/first-look-de.html" lang="de" hreflang="de">Einstieg auf Deutsch</a><a href="guides/interpretation.html">Understand the measurements</a><a href="guides/research-pdf.html">Sources and reading copies</a><a href="https://github.com/mfahsold/lixity/blob/main/docs/AUDIO.md">Audio and teleprompter</a><a href="https://github.com/mfahsold/lixity/blob/main/docs/README.md">All documentation</a><a href="blog/index.html">Articles</a><a href="https://github.com/mfahsold/lixity/blob/main/docs/AGENTS.md" id="cli-api">CLI and API</a><a href="https://github.com/mfahsold/lixity/blob/main/docs/METHODS.md" id="methods">Methods and limits</a></nav></div><div id="feedback"><h2>$feedback_title</h2><p>$feedback_text</p><a href="mailto:mfahsold@googlemail.com?subject=Lixity%20feedback">$feedback_link</a></div></section>
</main>
<footer class="home-footer"><div class="footer-top"><a class="brand" href="$home_path">Lixity</a><span>© 2026 Matthias Fahsold</span><a href="https://github.com/mfahsold/lixity/blob/main/docs/LICENSING.md" lang="en">AGPL-3.0-or-later · Open source</a><a href="https://github.com/mfahsold/lixity">$source</a><a href="$funding_url" hreflang="en">$funding</a><a rel="me" href="https://mastodon.social/@lixity">Mastodon</a><a rel="me" href="https://bsky.app/profile/lixity.bsky.social">Bluesky</a></div>
<p lang="en">Free for private and commercial writing, including self-publishing your book. A separate commercial license is available for integrations that cannot meet the AGPL. <a href="https://github.com/mfahsold/lixity/blob/main/docs/LICENSING.md">License details</a>.</p>
$footer
</footer>
<a class="site-back-top" href="#top">$top ↑</a>
</body></html>
