cask "lixity" do
  arch arm: "aarch64", intel: "x64"

  version "@VERSION@"
  sha256 arm:   "@SHA256_ARM64@",
         intel: "@SHA256_X64@"

  url "https://github.com/mfahsold/lixity/releases/download/v#{version}/Lixity_#{version}_#{arch}.dmg",
      verified: "github.com/mfahsold/lixity/"
  name "Lixity"
  desc "Offline manuscript analysis, close reading and traceable research workspace"
  homepage "https://mfahsold.github.io/lixity/"

  depends_on macos: ">= :monterey"

  app "Lixity.app"

  # Zap removes desktop host logs/UI state only; user manuscript folders and
  # research archives stay untouched on disk.
  zap trash: [
    "~/Library/Application Support/lixity/desktop",
    "~/Library/Application Support/lixity/service/desktop-sidecar.log",
    "~/Library/Caches/io.github.mfahsold.Lixity",
    "~/Library/Preferences/io.github.mfahsold.Lixity.plist",
  ]
end
