<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for CoreAudio microphone capture in teleprompter & voice calibration -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Required for loopback 127.0.0.1 HTTP transport and explicit opt-in release checks -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Required by bundled relocatable CPython C extensions (pydantic_core, orjson) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
